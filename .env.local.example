# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_EMAIL=contact@hansvidaure.dev

# Must be an address on a domain verified in Resend
# (https://resend.com/domains). Until a domain is verified you can use
# Resend's shared testing sender, e.g. "onboarding@resend.dev" — this only
# works for sending to your own Resend account email and is NOT suitable for
# production use.
EMAIL_FROM=

# Production site URL — no trailing slash. Used for canonical URLs, the
# sitemap, robots.txt, JSON-LD, and resolving the social share image.
NEXT_PUBLIC_SITE_URL=hansvidaure.dev

# Google Analytics 4 Measurement ID (GA4 Admin -> Data Streams -> your web
# stream). Public by design — safe to expose client-side. Leave blank to
# disable analytics entirely (no script is loaded without it).
NEXT_PUBLIC_GA_ID=

# Optional. A GitHub token for the trainer card and CI chips, which read
# public data once a day. Without one GitHub allows 60 requests an hour, which
# is usually enough; a free fine-grained token with read-only access to public
# repositories raises it to 5,000. If GitHub is unreachable, those bits hide.
GITHUB_TOKEN=

# Optional. Cloudflare Turnstile, the contact form's free bot check
# (https://dash.cloudflare.com -> Turnstile). Set both or neither: with only
# the secret, every message is rejected. Real keys only work on the hostnames
# listed on the widget, so for local testing use Cloudflare's test keys:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# (always pass). The site key is public; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
